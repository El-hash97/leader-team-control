# Neon pooled connection string (Neon console > Connect). Server-only.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Vercel Cron sends this as a Bearer token to /api/cron/auto-hadir/*
CRON_SECRET=
LTC_USERNAME=
LTC_PASSWORD=
# at least 32 random characters
SESSION_SECRET=
